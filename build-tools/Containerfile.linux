# Use Ubuntu 22.04 as base image
FROM ubuntu:22.04

# Set noninteractive installation
# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Step 1: Configure multi-architecture support and package sources
# Required for: arm64 and armhf cross-compilation
RUN dpkg --add-architecture arm64 && \
    dpkg --add-architecture armhf && \
    sed -i 's/deb http/deb [arch=amd64] http/g' /etc/apt/sources.list && \
    echo 'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy main restricted universe multiverse' >> /etc/apt/sources.list && \
    echo 'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-updates main restricted universe multiverse' >> /etc/apt/sources.list && \
    echo 'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-security main restricted universe multiverse' >> /etc/apt/sources.list && \
    echo 'deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports jammy main restricted universe multiverse' >> /etc/apt/sources.list && \
    echo 'deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports jammy-updates main restricted universe multiverse' >> /etc/apt/sources.list && \
    echo 'deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports jammy-security main restricted universe multiverse' >> /etc/apt/sources.list && \
    apt-get update

# Step 2: Install base development tools
# Required for: building and compiling code
RUN apt-get install -y \
        build-essential \
        cmake \
        wget \
        unzip \
        g++

# Step 3: Install cross-compilers
# Required for: arm64, armhf, and Windows builds
RUN apt-get install -y \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        gcc-arm-linux-gnueabihf \
        g++-arm-linux-gnueabihf \
        mingw-w64 \
        g++-mingw-w64-x86-64-posix

# Step 4: Install Linux architecture-specific libraries
# Required for: GPIO and Allegro support on different architectures
RUN apt-get install -y \
        libgpiod-dev \
        libgpiod-dev:arm64 \
        libgpiod-dev:armhf \
        liballegro5-dev \
        liballegro-image5-dev \
        liballegro-ttf5-dev \
        liballegro5-dev:arm64 \
        liballegro-image5-dev:arm64 \
        liballegro-ttf5-dev:arm64 \
        liballegro5-dev:armhf \
        liballegro-image5-dev:armhf \
        liballegro-ttf5-dev:armhf

# Step 5: Install Linux runtime libraries for Allegro and OpenGL
# Required for: Allegro support and graphics on Linux
RUN apt-get install -y \
        liballegro5.2 \
        liballegro-image5.2 \
        liballegro-ttf5.2 \
        libgl1-mesa-dri \
        libgl1-mesa-glx \
        mesa-utils

# Final cleanup
RUN rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /build

# Set default architecture (can be overridden at runtime)
ARG ARCH=x86_64
ENV TARGET_ARCH=$ARCH

# Set entrypoint
CMD ["/build/container-build.sh"]